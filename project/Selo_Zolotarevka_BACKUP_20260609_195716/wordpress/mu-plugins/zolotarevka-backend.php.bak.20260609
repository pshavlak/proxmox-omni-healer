function zolo_get_site_settings() {
    return wp_parse_args((array) get_option('zolo_site_settings', []), zolo_site_settings_defaults());
}

function zolo_get_page_content($slug) {
    return wp_parse_args((array) get_option('zolo_page_' . $slug . '_live', []), zolo_page_content_defaults($slug));
}

function zolo_get_page_content_draft($slug) {
    return wp_parse_args((array) get_option('zolo_page_' . $slug . '_draft', []), zolo_page_content_defaults($slug));
}

function zolo_save_page_content_draft($slug, $data) {
    update_option('zolo_page_' . $slug . '_draft', zolo_sanitize_page_content((array) $data), false);
}

function zolo_publish_page_content($slug) {
    update_option('zolo_page_' . $slug . '_live', get_option('zolo_page_' . $slug . '_draft', []), false);
}

function zolo_publish_all() {
    foreach (['home', 'school', 'kindergarten', 'farm', 'sports', 'village-life', 'media', 'news'] as $slug) {
        zolo_publish_page_content($slug);
    }
}

function zolo_has_draft_changes($slug) {
    return md5(serialize(get_option('zolo_page_' . $slug . '_draft', []))) !== md5(serialize(get_option('zolo_page_' . $slug . '_live', [])));
}

function zolo_sanitize_page_content($data) {
    $clean = [];
    if (!is_array($data)) {
        return $clean;
    }

    foreach ($data as $key => $value) {
        if (is_array($value)) {
            if (isset($value[0])) {
                $clean[$key] = [];
                foreach ($value as $item) {
                    $clean[$key][] = zolo_sanitize_page_content($item);
                }
            } else {
                $clean[$key] = zolo_sanitize_page_content($value);
            }
            continue;
        }

        if (is_bool($value)) {
            $clean[$key] = $value ? 1 : 0;
        } elseif (is_numeric($value)) {
            $clean[$key] = absint($value);
        } elseif (in_array($key, ['hero_image', 'page_image'], true)) {
            $clean[$key] = esc_url_raw($value);
        } else {
            $clean[$key] = in_array($key, ['history_text', 'culture_description', 'bulletin_description', 'suggest_text'], true)
                ? sanitize_textarea_field($value)
                : sanitize_text_field($value);
        }
    }

    return $clean;
}

function zolo_seed_default_content() {
    if (!get_option('zolo_site_settings')) {
        update_option('zolo_site_settings', zolo_site_settings_defaults(), false);
    }

    foreach (['home', 'school', 'kindergarten', 'farm', 'sports', 'village-life', 'media', 'news'] as $slug) {
        if (!get_option('zolo_page_' . $slug . '_draft')) {
            update_option('zolo_page_' . $slug . '_draft', zolo_page_content_defaults($slug), false);
        }
        if (!get_option('zolo_page_' . $slug . '_live')) {
            update_option('zolo_page_' . $slug . '_live', zolo_page_content_defaults($slug), false);
        }
    }
}

final class Zolotarevka_MVP_Settings {
    const CAP = 'zolo_edit_site_content';

    public static function init() {
        add_action('admin_menu', [__CLASS__, 'register_admin_menu']);
        add_action('admin_init', [__CLASS__, 'handle_save_page_content']);
        add_action('admin_init', [__CLASS__, 'handle_save_site_settings']);
        add_action('admin_init', [__CLASS__, 'handle_publish_all']);
        add_action('admin_init', [__CLASS__, 'handle_reset_page']);
        add_action('admin_init', 'zolo_seed_default_content');
    }

    public static function register_admin_menu() {
        add_menu_page('Управление сайтом', 'Золотаревка ⚙️', self::CAP, 'zolotarevka', [__CLASS__, 'render_dashboard'], 'dashicons-admin-generic', 3);

        add_submenu_page('zolotarevka', 'Панель управления', 'Панель управления', self::CAP, 'zolotarevka', [__CLASS__, 'render_dashboard']);
        add_submenu_page('zolotarevka', 'Настройки сайта', 'Настройки сайта', self::CAP, 'zolotarevka-settings', [__CLASS__, 'render_site_settings']);

        foreach (self::page_map() as $slug => $meta) {
            add_submenu_page('zolotarevka', $meta['title'], $meta['menu'], self::CAP, 'zolotarevka-page-' . $slug, [__CLASS__, 'render_page_' . str_replace('-', '_', $slug)]);
        }
    }

    private static function page_map() {
        return [
            'home' => ['title' => 'Главная страница', 'menu' => 'Главная'],
            'school' => ['title' => 'Школа', 'menu' => 'Школа'],
            'kindergarten' => ['title' => 'Детский сад', 'menu' => 'Детский сад'],
            'farm' => ['title' => 'Совхоз', 'menu' => 'Совхоз'],
            'sports' => ['title' => 'Спорт', 'menu' => 'Спорт'],
            'village-life' => ['title' => 'Жизнь села', 'menu' => 'Жизнь села'],
            'media' => ['title' => 'Медиа', 'menu' => 'Медиа'],
            'news' => ['title' => 'Новости', 'menu' => 'Новости'],
        ];
    }

    private static function notice() {
        if (empty($_GET['zolo_msg'])) {
            return;
        }
        $type = sanitize_key($_GET['zolo_type'] ?? 'info');
        $class = $type === 'success' ? 'notice-success' : ($type === 'error' ? 'notice-error' : 'notice-info');
        echo '<div class="notice ' . esc_attr($class) . '"><p>' . esc_html(wp_unslash($_GET['zolo_msg'])) . '</p></div>';
    }

    public static function handle_save_site_settings() {
        if (empty($_POST['zolo_site_settings_save'])) {
            return;
        }
        if (!current_user_can(self::CAP)) {
            wp_die('Доступ запрещён', 403);
        }
        check_admin_referer('zolo_site_settings_save');

        $settings = isset($_POST['zolo_site_settings']) ? (array) $_POST['zolo_site_settings'] : [];
        update_option('zolo_site_settings', zolo_sanitize_page_content($settings), false);

        wp_safe_redirect(add_query_arg(['page' => 'zolotarevka-settings', 'zolo_msg' => urlencode('Настройки сохранены'), 'zolo_type' => 'success'], admin_url('admin.php')));
        exit;
    }

    public static function handle_save_page_content() {
        if (empty($_POST['zolo_page_save']) || empty($_POST['zolo_page_slug'])) {
            return;
        }
        if (!current_user_can(self::CAP)) {
            wp_die('Доступ запрещён', 403);
        }

        $slug = sanitize_key(wp_unslash($_POST['zolo_page_slug']));
        check_admin_referer('zolo_save_page_' . $slug);

        $content = isset($_POST['zolo_content']) ? (array) $_POST['zolo_content'] : [];
        zolo_save_page_content_draft($slug, $content);

        $action = sanitize_key(wp_unslash($_POST['zolo_page_save']));
        if ($action === 'publish') {
            zolo_publish_page_content($slug);
            $msg = 'Опубликовано';
            $type = 'success';
        } elseif ($action === 'preview') {
            wp_safe_redirect(add_query_arg(['zolo_preview' => $slug], home_url('/' . ($slug === 'home' ? '' : $slug . '/'))));
            exit;
        } else {
            $msg = 'Черновик сохранён';
            $type = 'info';
        }

        wp_safe_redirect(add_query_arg(['page' => 'zolotarevka-page-' . $slug, 'zolo_msg' => urlencode($msg), 'zolo_type' => $type], admin_url('admin.php')));
        exit;
    }

    public static function handle_publish_all() {
        if (empty($_POST['zolo_publish_all'])) {
            return;
        }
        if (!current_user_can(self::CAP)) {
            wp_die('Доступ запрещён', 403);
        }
        check_admin_referer('zolo_publish_all');

        zolo_publish_all();
        wp_safe_redirect(add_query_arg(['page' => 'zolotarevka', 'zolo_msg' => urlencode('Все страницы опубликованы'), 'zolo_type' => 'success'], admin_url('admin.php')));
        exit;
    }

    public static function handle_reset_page() {
        if (empty($_POST['zolo_reset_page']) || empty($_POST['zolo_page_slug'])) {
            return;
        }
        if (!current_user_can(self::CAP)) {
            wp_die('Доступ запрещён', 403);
        }
        $slug = sanitize_key(wp_unslash($_POST['zolo_page_slug']));
        check_admin_referer('zolo_reset_' . $slug);

        $defaults = zolo_page_content_defaults($slug);
        update_option('zolo_page_' . $slug . '_draft', $defaults, false);
        update_option('zolo_page_' . $slug . '_live', $defaults, false);

        wp_safe_redirect(add_query_arg(['page' => 'zolotarevka-page-' . $slug, 'zolo_msg' => urlencode('Сброшено на умолчания'), 'zolo_type' => 'info'], admin_url('admin.php')));
        exit;
    }


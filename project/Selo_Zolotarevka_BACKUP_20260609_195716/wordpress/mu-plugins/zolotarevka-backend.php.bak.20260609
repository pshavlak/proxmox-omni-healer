    private static function render_field($field, $value) {
        $type = $field['type'] ?? 'text';
        $name = $field['name'] ?? '';
        $label = $field['label'] ?? '';
        $placeholder = $field['placeholder'] ?? '';
        $rows = (int) ($field['rows'] ?? 4);

        echo '<p><label><strong>' . esc_html($label) . '</strong></label><br>';
        if ($type === 'textarea') {
            echo '<textarea name="zolo_content[' . esc_attr($name) . ']" rows="' . (int) $rows . '" placeholder="' . esc_attr($placeholder) . '" style="width:100%;max-width:800px;">' . esc_textarea($value) . '</textarea>';
        } elseif ($type === 'number') {
            echo '<input type="number" name="zolo_content[' . esc_attr($name) . ']" value="' . esc_attr((string) $value) . '" min="0" style="width:120px;">';
        } elseif ($type === 'checkbox') {
            echo '<label><input type="hidden" name="zolo_content[' . esc_attr($name) . ']" value="0"><input type="checkbox" name="zolo_content[' . esc_attr($name) . ']" value="1" ' . checked((bool) $value, true, false) . '> ' . esc_html($label) . '</label>';
        } elseif ($type === 'image') {
            $img_url = esc_attr((string) $value);
            echo '<div class="zolo-image-field">';
            echo '<input type="url" name="zolo_content[' . esc_attr($name) . ']" value="' . $img_url . '" placeholder="URL изображения" style="width:70%;max-width:500px;" class="zolo-image-url">';
            echo ' <button type="button" class="button zolo-select-image" style="vertical-align:baseline;">📷 Выбрать</button>';
            echo ' <button type="button" class="button zolo-upload-image" style="vertical-align:baseline;">📤 Загрузить</button>';
            if ($img_url) {
                echo '<br><img src="' . $img_url . '" style="max-width:300px;max-height:150px;margin-top:8px;border-radius:4px;border:1px solid #ddd;">';
            }
            echo '</div>';
        } else {
            echo '<input type="' . esc_attr($type === 'url' ? 'url' : 'text') . '" name="zolo_content[' . esc_attr($name) . ']" value="' . esc_attr((string) $value) . '" placeholder="' . esc_attr($placeholder) . '" style="width:100%;max-width:800px;">';
        }
        echo '</p>';
    }

    private static function render_repeater($name, $label, $items, $subfields) {
        ?>
        <div class="zolo-repeater" data-name="<?php echo esc_attr($name); ?>">
            <p><strong><?php echo esc_html($label); ?></strong></p>
            <div class="zolo-repeater-items">
                <?php foreach ((array) $items as $idx => $item): ?>
                    <div class="zolo-repeater-item" style="background:#f6f7f7;padding:12px;margin-bottom:8px;border-radius:4px;position:relative;">
                        <?php foreach ($subfields as $key => $def): ?>
                            <?php $def = is_array($def) ? $def : ['label' => $def, 'type' => 'text']; ?>
                            <div style="margin-bottom:6px;">
                                <label style="font-size:12px;color:#666;"><?php echo esc_html($def['label'] ?? $key); ?></label>
                                <?php if (($def['type'] ?? 'text') === 'textarea'): ?>
                                    <textarea name="zolo_content[<?php echo esc_attr($name); ?>][<?php echo (int) $idx; ?>][<?php echo esc_attr($key); ?>]" rows="<?php echo (int) ($def['rows'] ?? 3); ?>" placeholder="<?php echo esc_attr($def['placeholder'] ?? ''); ?>" style="width:100%;"><?php echo esc_textarea($item[$key] ?? ''); ?></textarea>
                                <?php else: ?>
                                    <input type="<?php echo esc_attr(($def['type'] ?? 'text') === 'number' ? 'number' : (($def['type'] ?? 'text') === 'url' ? 'url' : 'text')); ?>" name="zolo_content[<?php echo esc_attr($name); ?>][<?php echo (int) $idx; ?>][<?php echo esc_attr($key); ?>]" value="<?php echo esc_attr($item[$key] ?? ''); ?>" placeholder="<?php echo esc_attr($def['placeholder'] ?? ''); ?>" <?php echo (($def['type'] ?? 'text') === 'number') ? 'min="0"' : ''; ?> style="width:<?php echo $key === 'file_url' ? 'calc(100% - 110px)' : '100%'; ?>;">
                                    <?php if ($key === 'file_url'): ?><button type="button" class="button zolo-select-file" style="vertical-align:baseline;margin-left:4px;">📎 Выбрать</button><button type="button" class="button zolo-upload-file" style="vertical-align:baseline;margin-left:4px;">📤 Загрузить</button><?php endif; ?>
                                <?php endif; ?>
                            </div>
                        <?php endforeach; ?>
                        <button type="button" class="button zolo-remove-item" style="position:absolute;top:8px;right:8px;background:#dc3545;color:#fff;border:none;">✕</button>
                    </div>
                <?php endforeach; ?>
            </div>
            <button type="button" class="button zolo-add-item" data-name="<?php echo esc_attr($name); ?>" data-fields="<?php echo esc_attr(wp_json_encode($subfields)); ?>">+ Добавить</button>
        </div>
        <?php
    }

    private static function render_page_form($slug, $title, $fields) {
        $content = zolo_get_page_content_draft($slug);
        ?>
        <div class="wrap">
            <h1><?php echo esc_html($title); ?></h1>
            <?php self::notice(); ?>
            <?php if (zolo_has_draft_changes($slug)): ?>
                <div class="notice notice-warning"><p>Есть неопубликованные изменения.</p></div>
            <?php endif; ?>
            <form method="post">
                <input type="hidden" name="zolo_page_slug" value="<?php echo esc_attr($slug); ?>">
                <?php wp_nonce_field('zolo_save_page_' . $slug); ?>
                <div style="background:#fff;border:1px solid #dcdcde;padding:20px;max-width:900px;">
                    <?php foreach ($fields as $field): ?>
                        <?php
                        $type = $field['type'] ?? 'text';
                        if ($type === 'section') {
                            echo '<hr><h2 style="margin-top:24px;">' . esc_html($field['label'] ?? '') . '</h2>';
                            continue;
                        }
                        if ($type === 'repeater') {
                            self::render_repeater($field['name'], $field['label'], $content[$field['name']] ?? [], $field['subfields'] ?? []);
                            continue;
                        }
                        self::render_field($field, $content[$field['name']] ?? '');
                        ?>
                    <?php endforeach; ?>
                </div>
                <p style="margin-top:16px;">
                    <button type="submit" name="zolo_page_save" value="draft" class="button button-primary">Сохранить черновик</button>
                    <button type="submit" name="zolo_page_save" value="preview" class="button">Сохранить и предпросмотреть</button>
                    <button type="submit" name="zolo_page_save" value="publish" class="button button-primary" style="background:#2d6a4f;border-color:#2d6a4f;">Опубликовать</button>
                </p>
            </form>
            <form method="post">
                <input type="hidden" name="zolo_page_slug" value="<?php echo esc_attr($slug); ?>">
                <?php wp_nonce_field('zolo_reset_' . $slug); ?>
                <button type="submit" name="zolo_reset_page" value="1" class="button" style="color:#b32d2e;" onclick="return confirm('Сбросить на умолчания?');">Сбросить на умолчания</button>
            </form>
        </div>
        <script>
        (function() {
            // File library integration (for zolo-select-file)
            document.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('zolo-select-file')) {
                    e.preventDefault();
                    var btn = e.target;
                    var input = btn.previousElementSibling;
                    if (typeof wp !== 'undefined' && wp.media && wp.media.editor) {
                        var frame = wp.media({
                            title: 'Выберите файл',
                            button: { text: 'Выбрать' },
                            multiple: false
                        });
                        frame.on('select', function() {
                            var attachment = frame.state().get('selection').first().toJSON();
                            input.value = attachment.url;
                        });
                        frame.open();
                    } else {
                        var url = prompt('Введите URL файла:');
                        if (url) input.value = url;
                    }
                }
            });
            // Upload file from computer (for zolo-upload-file)
            document.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('zolo-upload-file')) {
                    e.preventDefault();
                    var btn = e.target;
                    var input = btn.previousElementSibling;
                    if (typeof wp !== 'undefined' && wp.media) {
                        var frame = wp.media({
                            title: 'Загрузить файл с компьютера',
                            button: { text: 'Загрузить' },
                            multiple: false,
                            library: { type: ['application','text','image'] }
                        });
                        frame.on('select', function() {
                            var attachment = frame.state().get('selection').first().toJSON();
                            input.value = attachment.url;
                        });
                        // Switch to upload tab
                        var uploadTab = frame.$el.find('.media-menu-item:contains(\'Загрузить\')');
                        if (uploadTab.length) uploadTab.click();
                        frame.open();
                    } else {
                        var url = prompt('Введите URL файла:');
                        if (url) input.value = url;
                    }
                }
            });
            // Upload image from computer (for zolo-upload-image)
            document.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('zolo-upload-image')) {
                    e.preventDefault();
                    var btn = e.target;
                    var input = btn.previousElementSibling;
                    if (typeof wp !== 'undefined' && wp.media) {
                        var frame = wp.media({
                            title: 'Загрузить изображение с компьютера',
                            button: { text: 'Загрузить' },
                            multiple: false,
                            library: { type: 'image' }
                        });
                        frame.on('select', function() {
                            var attachment = frame.state().get('selection').first().toJSON();
                            input.value = attachment.url;
                            var preview = btn.parentElement.querySelector('img');
                            if (preview) {
                                preview.src = attachment.url;
                            } else {
                                var img = document.createElement('img');
                                img.src = attachment.url;
                                img.style.cssText = 'max-width:300px;max-height:150px;margin-top:8px;border-radius:4px;border:1px solid #ddd;';
                                btn.parentElement.appendChild(img);
                            }
                        });
                        // Switch to upload tab
                        var uploadTab = frame.$el.find('.media-menu-item:contains(\'Загрузить\')');
                        if (uploadTab.length) uploadTab.click();
                        frame.open();
                    } else {
                        var url = prompt('Введите URL изображения:');
                        if (url) {
                            input.value = url;
                            var preview = btn.parentElement.querySelector('img');
                            if (preview) {
                                preview.src = url;
                            }
                        }
                    }
                }
            });
            // Image library integration (for zolo-select-image)
            document.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('zolo-select-image')) {
                    e.preventDefault();
                    var btn = e.target;
                    var input = btn.previousElementSibling;
                    if (typeof wp !== 'undefined' && wp.media && wp.media.editor) {
                        var frame = wp.media({
                            title: 'Выберите изображение',
                            button: { text: 'Выбрать' },
                            multiple: false
                        });
                        frame.on('select', function() {
                            var attachment = frame.state().get('selection').first().toJSON();
                            input.value = attachment.url;
                            var preview = btn.parentElement.querySelector('img');
                            if (preview) {
                                preview.src = attachment.url;
                            } else {
                                var img = document.createElement('img');
                                img.src = attachment.url;
                                img.style.cssText = 'max-width:300px;max-height:150px;margin-top:8px;border-radius:4px;border:1px solid #ddd;';
                                btn.parentElement.appendChild(img);
                            }
                        });
                        frame.open();
                    } else {
                        // Fallback: prompt for URL
                        var url = prompt('Введите URL изображения:');
                        if (url) {
                            input.value = url;
                            var preview = btn.parentElement.querySelector('img');
                            if (preview) {
                                preview.src = url;
                            }
                        }
                    }
                }
            });
            document.querySelectorAll('.zolo-add-item').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var name = this.dataset.name;
                    var fields = JSON.parse(this.dataset.fields);
                    var container = this.previousElementSibling;
                    var idx = container.querySelectorAll('.zolo-repeater-item').length;
                    var div = document.createElement('div');
                    div.className = 'zolo-repeater-item';
                    div.style.cssText = 'background:#f6f7f7;padding:12px;margin-bottom:8px;border-radius:4px;position:relative;';
                    var html = '';
                    for (var key in fields) {
                        if (!Object.prototype.hasOwnProperty.call(fields, key)) continue;
                        var f = fields[key];
                        var type = f.type || 'text';
                        html += '<div style="margin-bottom:6px;"><label style="font-size:12px;color:#666;">' + (f.label || key) + '</label>';
                        if (type === 'textarea') {
                            html += '<textarea name="zolo_content[' + name + '][' + idx + '][' + key + ']" rows="' + (f.rows || 3) + '" placeholder="' + (f.placeholder || '') + '" style="width:100%;"></textarea>';
                        } else {
                            var width = key === 'file_url' ? 'calc(100% - 110px)' : '100%';
                            html += '<input type="' + (type === 'number' ? 'number' : (type === 'url' ? 'url' : 'text')) + '" name="zolo_content[' + name + '][' + idx + '][' + key + ']" value="" placeholder="' + (f.placeholder || '') + '" style="width:' + width + ';"' + (type === 'number' ? ' min="0"' : '') + '>';
                            if (key === 'file_url') {
                                html += '<button type="button" class="button zolo-select-file" style="vertical-align:baseline;margin-left:4px;">📎 Выбрать</button>';
                            if (key === 'file_url') {
                                html += '<button type="button" class="button zolo-upload-file" style="vertical-align:baseline;margin-left:4px;">📤 Загрузить</button>';
                            }
                            }
                        }
                        html += '</div>';
                    }
                    html += '<button type="button" class="button zolo-remove-item" style="position:absolute;top:8px;right:8px;background:#dc3545;color:#fff;border:none;">✕</button>';
                    div.innerHTML = html;
                    container.appendChild(div);
                });
            });
            document.addEventListener('click', function(e) {
                if (e.target && e.target.classList.contains('zolo-remove-item')) {
                    e.target.closest('.zolo-repeater-item').remove();
                }
            });
        })();
        </script>
        <?php
    }

